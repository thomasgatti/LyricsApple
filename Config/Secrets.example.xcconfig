// Copia questo file in "Secrets.xcconfig" (stessa cartella) e compila i valori.
// Secrets.xcconfig è escluso da git.

// Client ID dell'app creata su https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID =

// Identificativo univoco dell'app: sostituisci "tuonome" con qualcosa di tuo (solo lettere, numeri, punti).
APP_BUNDLE_ID = com.tuonome.lyricsapple

// Team ID Apple (opzionale: puoi anche sceglierlo in Xcode > Signing & Capabilities).
DEVELOPMENT_TEAM =
